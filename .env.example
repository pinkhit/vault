# Compose reads this file after copying it to .env. No secrets needed for Milestone 1.
# Host binding is always 127.0.0.1. Do not expose this prototype remotely.
FAMILYVAULT_PORT=8080
FAMILYVAULT_MAX_UPLOAD_BYTES=26214400

# Native Go overrides (export in your shell; Go does not automatically load .env):
# FAMILYVAULT_ADDR=127.0.0.1:8080
# FAMILYVAULT_DATA_DIR=./data
# FAMILYVAULT_STATIC_DIR=../frontend/dist
