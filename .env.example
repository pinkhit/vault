# Compose reads this file after copying it to .env. Passwords are never set here.
# Host publishing stays 127.0.0.1. Private HTTPS setup: docs/private-access.md.
SAFEVAULT_PORT=8080
SAFEVAULT_MAX_UPLOAD_BYTES=26214400
SAFEVAULT_SESSION_TTL=8h
SAFEVAULT_SESSION_IDLE_TTL=30m
# Explicit HTTP localhost development exception. Configured HTTPS mode requires true.
SAFEVAULT_COOKIE_SECURE=false
# Milestone 5: optional exact HTTPS origin; also requires COOKIE_SECURE=true.
# Leave empty for localhost HTTP. This setting does not install or enable a proxy.
SAFEVAULT_PUBLIC_ORIGIN=
# macOS host collector uses Docker Desktop's default Docker.raw location.
# If moved, set SAFEVAULT_DOCKER_DISK before scripts/macos-storage.sh start.
# SAFEVAULT_DOCKER_DISK=/Volumes/External/Docker/Docker.raw

# Native Go overrides (export in your shell; Go does not automatically load .env):
# SAFEVAULT_ADDR=127.0.0.1:8080
# SAFEVAULT_DATA_DIR=./data
# SAFEVAULT_STATIC_DIR=../frontend/dist
