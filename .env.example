# Compose reads this file after copying it to .env. Passwords are never set here.
# Host binding is always 127.0.0.1. Do not expose this prototype remotely.
FAMILYVAULT_PORT=8080
FAMILYVAULT_MAX_UPLOAD_BYTES=26214400
FAMILYVAULT_SESSION_TTL=8h
FAMILYVAULT_SESSION_IDLE_TTL=30m
# Explicit HTTP localhost development exception. HTTPS requires true in a later milestone.
FAMILYVAULT_COOKIE_SECURE=false
# macOS host collector uses Docker Desktop's default Docker.raw location.
# If moved, set FAMILYVAULT_DOCKER_DISK before scripts/macos-storage.sh start.
# FAMILYVAULT_DOCKER_DISK=/Volumes/External/Docker/Docker.raw

# Native Go overrides (export in your shell; Go does not automatically load .env):
# FAMILYVAULT_ADDR=127.0.0.1:8080
# FAMILYVAULT_DATA_DIR=./data
# FAMILYVAULT_STATIC_DIR=../frontend/dist
